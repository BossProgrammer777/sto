# ── Пример переменных окружения ──
# На Railway задай эти переменные в разделе Variables (значения НЕ коммитить!).
# Локально можно скопировать этот файл в .env и заполнить.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...

# ID Google-таблицы (часть URL между /d/ и /edit)
SPREADSHEET_ID=10aYlAa3TXVA9cDti6cfeY1bO3rN7qjAqh9Mp7GhB5Jc

# Содержимое JSON-ключа сервисного аккаунта ОДНОЙ строкой (весь файл целиком).
# На Railway вставляй как есть — многострочный JSON тоже принимается.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# Операторы: маппинг Telegram ID -> имя МОП (строго как в выпадающем списке таблицы).
# Ключи этого объекта = whitelist доступа к боту (кто может пользоваться).
OPERATORS_JSON={"123456789":"Симоненко Сергей","987654321":"Александров Егор"}

# (необязательно) Отдельный whitelist ID через запятую, если он шире маппинга выше.
# ALLOWED_OPERATOR_IDS=123456789,987654321

# Имя служебного «плоского» листа, куда бот пишет записи (подход Б).
FLAT_SHEET_NAME=Записи_Бот

# На сколько дней вперёд показывать даты для записи.
DAYS_AHEAD=14

# Писать ли запись напрямую в «красивую» простыню (подход А). По умолчанию выкл.
WRITE_TO_GRID=false
